  },
  "provisionalOnyxBehaviours": [
    {
      "id": "durable-inbox-replay-budget",
      "pinned": false,
      "behaviour": "Local durable storage policy (SV-37): retain all unique canonical wrap IDs, including terminal failures and invitation-only legacy IDs, without timestamp/watermark eviction. Stop ingestion with a nonretryable BUDGET error when another decision cannot fit <=4096 IDs and <=256 KiB of serialized JSON IDs (effective maximum 3912 canonical IDs). Check before opening/writing invitations and again before account CAS writes. Persist the final decision before latching; full stores remain closed on restart and over-budget legacy stores are refused unchanged."
    },
    {
      "id": "blossom-owned-deadlines",
      "pinned": false,
      "behaviour": "Local adapter policy (SV-31), not a Blossom protocol change: 30000 ms total per GET/HEAD/PUT including signing, one authentication retry and response reading; 5000 ms without response-body byte progress. Empty chunks do not reset idle. Deadline failure is retryable NETWORK, never durable success; lifecycle/caller cancellation remains CANCELLED."
    },
    {
      "id": "bounded-network-ingress",
      "pinned": false,
      "behaviour": "Local admission policy (SV-29), not a nostrc wire-format extension: raw text frames <=144 KiB, recognised event fields <=128 KiB, content <=90000 UTF-8 bytes (87472 for NIP-59), <=128 tags/8 fields per tag, <=2048 UTF-8 bytes per tag string and <=16 KiB serialized tags. One SDK consumer per connection and one grant opener per engine; each queue is <=64 items/1 MiB. Backfill streams events and retains at most 4096 ID/timestamp page entries. Signature verification remains before decryption."
    },
    {
      "id": "member-head-parents",
      "pinned": false,
      "planSection": "6.8",
      "behaviour": "Own previous tuple plus owner checkpoint tuple; vault_head_include semantics: highest seq per writer, sorted by writer, max 64, no truncation. nostrc has no non-owner constructor."
    },
    {
      "id": "fold-input-cache-audit",
      "pinned": false,
      "planSection": "6.8",
      "behaviour": "Only latest per-author heads enter the bounded checkpoint fold. Historical same-revision owner records are separate linear ambiguity/equivocation audits, not frontier/disposition/retained-root candidates; their roots remain retained by the cache. Member ties remain explicit frontier forks. Only canonical-equivalent wrappers use outer replaceable ordering to choose signature evidence, never differing bodies."
    },
    {
      "id": "publication-graph-preflight",
      "pinned": false,
      "planSection": "6.4",
      "behaviour": "Before any manifest PUT or owner-head construction, enforce the reader's aggregate 500000-path and 64 MiB sealed-manifest reception limits. C tree validation/sealing/head construction omit these aggregate checks. No wire-format extension."
    },
    {
      "id": "nip4e-layering",
      "pinned": false,
      "planSection": "5.6",
      "defaultEnabled": false,
      "behaviour": "Both seal and wrap encrypt to recipient device key; seal remains signed by owner identity. Identity pubkeys stay in policy. Outer p tag only, no proprietary annotation; explicit identity fallback."
    }
  ],
